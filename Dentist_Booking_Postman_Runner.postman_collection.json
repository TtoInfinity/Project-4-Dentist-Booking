    {
      "name": "User View Product",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"User View Product (Dentists): Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const jsonData = pm.response.json();",
              "pm.test(\"User View Product: Dentist list is returned\", function () {",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data).to.be.an(\"array\").that.is.not.empty;",
              "});",
              "",
              "if (jsonData.data && jsonData.data.length > 0) {",
              "    const testDates = [\"2026-12-01\", \"2026-12-02\", \"2026-12-05\", \"2026-12-15\", \"2026-12-20\"];",
              "    const availableDentist = jsonData.data.find(d => {",
              "        const leaves = d.leaveDates || [];",
              "        return !testDates.some(td => leaves.includes(td));",
              "    }) || jsonData.data[0];",
              "",
              "    pm.collectionVariables.set(\"dentist_id\", availableDentist._id);",
              "    pm.environment.set(\"dentist_id\", availableDentist._id);",
              "    pm.globals.set(\"dentist_id\", availableDentist._id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
