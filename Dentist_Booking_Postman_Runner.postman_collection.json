    {
      "name": "User Registration + Validation Check (Invalid Input)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const baseUrl = pm.collectionVariables.get(\"BASE_URL\") || \"http://localhost:5000\";",
              "const adminEmail = pm.collectionVariables.get(\"admin_email\") || \"admin.runner@dentistbooking.com\";",
              "const adminPassword = pm.collectionVariables.get(\"admin_password\") || \"12345678\";",
              "",
              "// Step 1 of background seed: Ensure Admin user exists in DB",
              "pm.sendRequest({",
              "    url: `${baseUrl}/api/v1/auth/register`,",
              "    method: \"POST\",",
              "    header: { \"Content-Type\": \"application/json\" },",
              "    body: {",
              "        mode: \"raw\",",
              "        raw: JSON.stringify({",
              "            name: \"Runner Admin\",",
              "            tel: \"0899999999\",",
              "            email: adminEmail,",
              "            password: adminPassword,",
              "            role: \"admin\"",
              "        })",
              "    }",
              "}, function () {});"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Validation Check: Status code is 400 for invalid registration data\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test(\"Validation Check: Response has success false\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(false);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Invalid User\",\n    \"email\": \"invalid-email-format\",\n    \"password\": \"123\",\n    \"role\": \"user\"\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/api/v1/auth/register",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "register"
          ]
        }
      },
      "response": []
    },
    {
      "name": "User Registration",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const uniqueId = Date.now() + Math.floor(Math.random() * 1000);",
              "const email = `user_${uniqueId}@gmail.com`;",
              "const password = \"12345678\";",
              "const name = `User ${uniqueId}`;",
              "const tel = \"0812345678\";",
              "",
              "pm.collectionVariables.set(\"user_email\", email);",
              "pm.collectionVariables.set(\"user_password\", password);",
              "pm.collectionVariables.set(\"user_name\", name);",
              "pm.collectionVariables.set(\"user_tel\", tel);",
              "pm.environment.set(\"user_email\", email);",
              "pm.environment.set(\"user_password\", password);",
              "",
              "// Step 2 of background seed: Obtain Admin token so we can ensure a Dentist exists",
              "const baseUrl = pm.collectionVariables.get(\"BASE_URL\") || \"http://localhost:5000\";",
              "const adminEmail = pm.collectionVariables.get(\"admin_email\") || \"admin.runner@dentistbooking.com\";",
              "const adminPassword = pm.collectionVariables.get(\"admin_password\") || \"12345678\";",
              "",
              "pm.sendRequest({",
              "    url: `${baseUrl}/api/v1/auth/login`,",
              "    method: \"POST\",",
              "    header: { \"Content-Type\": \"application/json\" },",
              "    body: {",
              "        mode: \"raw\",",
              "        raw: JSON.stringify({ email: adminEmail, password: adminPassword })",
              "    }",
              "}, function (err, res) {",
              "    if (!err && res && res.json() && res.json().token) {",
              "        pm.collectionVariables.set(\"ADMIN_TOKEN\", res.json().token);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"User Registration: Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "const jsonData = pm.response.json();",
              "pm.test(\"User Registration: Returns JWT token\", function () {",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.token).to.be.a(\"string\");",
              "});",
              "",
              "if (jsonData.token) {",
              "    pm.collectionVariables.set(\"TOKEN\", jsonData.token);",
              "    pm.collectionVariables.set(\"USER_TOKEN\", jsonData.token);",
              "    pm.environment.set(\"TOKEN\", jsonData.token);",
              "    pm.environment.set(\"USER_TOKEN\", jsonData.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"{{user_name}}\",\n    \"tel\": \"{{user_tel}}\",\n    \"email\": \"{{user_email}}\",\n    \"password\": \"{{user_password}}\",\n    \"role\": \"user\"\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/api/v1/auth/register",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "register"
          ]
        }
      },
      "response": []
    },
    {
      "name": "User Log-in",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Step 3 of background seed: Ensure at least one Dentist exists in DB",
              "const baseUrl = pm.collectionVariables.get(\"BASE_URL\") || \"http://localhost:5000\";",
              "const adminToken = pm.collectionVariables.get(\"ADMIN_TOKEN\");",
              "if (adminToken) {",
              "    pm.sendRequest({",
              "        url: `${baseUrl}/api/v1/dentists`,",
              "        method: \"POST\",",
              "        header: {",
              "            \"Content-Type\": \"application/json\",",
              "            \"Authorization\": `Bearer ${adminToken}`",
              "        },",
              "        body: {",
              "            mode: \"raw\",",
              "            raw: JSON.stringify({",
              "                name: \"Dr. Somchai SmileClinic\",",
              "                yearsOfExperience: 10,",
              "                areaOfExpertise: \"Orthodontics\",",
              "                price: 1500,",
              "                leaveDates: [\"2026-12-25\"]",
              "            })",
              "        }",
              "    }, function () {});",
              "}"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"User Log-in: Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const jsonData = pm.response.json();",
              "pm.test(\"User Log-in: Returns valid token\", function () {",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.token).to.be.a(\"string\");",
              "});",
              "",
              "if (jsonData.token) {",
              "    pm.collectionVariables.set(\"TOKEN\", jsonData.token);",
              "    pm.collectionVariables.set(\"USER_TOKEN\", jsonData.token);",
              "    pm.environment.set(\"TOKEN\", jsonData.token);",
              "    pm.environment.set(\"USER_TOKEN\", jsonData.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
