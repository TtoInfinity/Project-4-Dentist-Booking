      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"User Delete Own Booking: Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const jsonData = pm.response.json();",
              "pm.test(\"User Delete Own Booking: Booking is deleted\", function () {",
              "    pm.expect(jsonData.success).to.eql(true);",
              "});",
              "",
              "// Recreate a booking for this user before logging out so Admin has a booking to View/Edit/Delete in the next steps",
              "const baseUrl = pm.collectionVariables.get(\"BASE_URL\") || \"http://localhost:5000\";",
              "const userToken = pm.collectionVariables.get(\"USER_TOKEN\") || pm.collectionVariables.get(\"TOKEN\");",
              "const dentistId = pm.collectionVariables.get(\"dentist_id\");",
              "",
              "pm.sendRequest({",
              "    url: `${baseUrl}/api/v1/dentists/${dentistId}/bookings`,",
              "    method: \"POST\",",
              "    header: {",
              "        \"Content-Type\": \"application/json\",",
              "        \"Authorization\": `Bearer ${userToken}`",
              "    },",
              "    body: {",
              "        mode: \"raw\",",
              "        raw: JSON.stringify({ bookingDate: \"2026-12-15T10:00:00.000Z\" })",
              "    }",
              "}, function (err, res) {",
              "    if (!err && res && res.json() && res.json().data) {",
              "        const newBookingId = res.json().data._id;",
              "        pm.collectionVariables.set(\"booking_id\", newBookingId);",
              "        pm.environment.set(\"booking_id\", newBookingId);",
              "        pm.globals.set(\"booking_id\", newBookingId);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
